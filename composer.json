{
    "name": "laravel/laravel",
    "description": "包网演示站",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "^2.7",
        "laravel/framework": "^11.44.1 <12.0",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "^3.1",
        "overtrue/laravel-wechat": "^7.3",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": ["app/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-d5tc-s1qs-h781": "修复在 Laravel 12，11 无修复版本",
                    "PKSA-m5cs-t1y6-qpcs": "修复在 Laravel 12，11 无修复版本",
                    "PKSA-3r5d-mb8f-1qw9": "修复在 Laravel 12，11 无修复版本",
                    "PKSA-mdq4-51ck-6kdq": "修复在 Laravel 12，11 无修复版本"
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
